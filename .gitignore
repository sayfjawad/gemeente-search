# --- secrets / local config ---
.env

# --- shared venv symlink ---
.venv

# --- Python ---
__pycache__/
*.pyc

# --- runtime state ---
stats.sqlite

# --- generated / derived data (large; re-crawlable / re-buildable) ---
data/*/pdfs/
data/*/embeddings.npy
data/*/index.sqlite
# SQLite transient files written mid-ingest/build (never committed)
data/*/index.sqlite-journal
data/*/index.sqlite-wal
data/*/index.sqlite-shm
data/*/build_index.log
data/*/ingest.log
data/*/crawl/*.log
data/*/crawl/*state*.json
# Onboarding moved crawl + pdfs onto the NAS (/mnt/gemeente-live) and the
# data/<slug>/crawl + data/<slug>/pdfs dirs are now symlinks into it.  The 6
# originally-hand-onboarded municipalities' docs.jsonl are still tracked from
# before that migration; everything else is re-crawlable and must stay out of git.
data/*/crawl
data/*/pdfs

# --- onboarding runtime state (persisted between runs, not source) ---
scripts/onboarding_queue.json
scripts/onboard_all.log
scripts/*.bak-*
*.bak-*
.env.bak-*
scripts/.step_*.log
scripts/*.log
