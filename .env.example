# gemeente-search runtime config — copy to .env and fill in values.

# LLM = GPT-OSS-120B served by llama.cpp (see docs/architecture/03-platforms/llm-node.md).
# Point this at your llama.cpp OpenAI-compatible endpoint. GPT-OSS is a reasoning
# model -> app.py sends chat_template_kwargs {enable_thinking:false} so `content`
# is populated (otherwise it's empty).
LLM_BASE_URL=http://localhost:8083/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=none

# BGE-M3 embedder runs on the default CUDA device (GPU 0 on the Z8).
# CUDA_VISIBLE_DEVICES=0

# Email notify (scripts/notify.py) — SMTP. All SMTP_* must be set for milestone emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
MAIL_FROM=noreply@example.com
MAIL_TO=you@example.com
