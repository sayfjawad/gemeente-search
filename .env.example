# gemeente-search runtime config — kopieer naar .env en vul in. .env staat NIET in git.

# --- Taalmodel (verplicht voor /api/ask en /api/compare) -------------------
# Elk OpenAI-compatibel /v1/chat/completions-endpoint werkt.
# Productie: gedeelde Qwen3.8-27B op vLLM op dezelfde host (zie ADR-016).
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=none
# Terugvalpad: externe API (vragen verlaten dan je eigen infra, zie ADR-013).
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-pro
# LLM_API_KEY=<jouw key>

# --- Embeddings (BGE-M3) ---------------------------------------------------
# Leeg = CPU (productie: de GPU's zijn voor de LLM). Zet een GPU-index voor
# snellere bulk-embedding in build_index.py.
# CUDA_VISIBLE_DEVICES=0

# --- E-mail bij onboarding-mijlpalen (optioneel, scripts/notify.py) --------
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
MAIL_FROM=noreply@example.com
MAIL_TO=you@example.com
