# gemeente-search runtime config — copy to .env and fill in values.

# LLM = GPT-OSS-120B served by llama.cpp on the gx10 node (Tailscale 100.64.x.x).
# GPT-OSS is a reasoning model -> app.py sends chat_template_kwargs
# {enable_thinking:false} so `content` is populated (otherwise it's empty).
LLM_BASE_URL=http://100.64.x.x:8083/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=none

# BGE-M3 embedder runs on the default CUDA device (GPU 0 on the Z8).
# CUDA_VISIBLE_DEVICES=0

# Email notify (scripts/notify.py) — TransIP SMTP.
SMTP_PASSWORD=changeme
