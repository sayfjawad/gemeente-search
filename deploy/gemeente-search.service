[Unit]
Description=Gemeente IJsselstein smart search (FastAPI, port 8905)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/git/gemeente-search
EnvironmentFile=%h/git/gemeente-search/.env
ExecStart=%h/git/gemeente-search/.venv/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8905
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
